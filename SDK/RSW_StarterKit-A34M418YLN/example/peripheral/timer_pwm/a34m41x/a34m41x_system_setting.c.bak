#include "main.h"

#include "a34m41x_scu.h"

void System_Setting_Config(void)
{
    struct scu_main_clock_cfg cfg =
    {
        .mclk_sel = SCU_CLOCK_HSE,
        .mclk_div = SCU_MAIN_CLOCK_DIV_NONE,
        .hclk_div = SCU_AHB_CLOCK_DIV_NONE,
        .mclk_hz = 8000000,
    };

    HAL_SCU_UpdateMainClock(&cfg);
}

